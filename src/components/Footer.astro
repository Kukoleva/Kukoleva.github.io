---
import { site } from '../lib/site'

const socials = [
  { label: 'Telegram', href: site.socials.telegram },
  { label: 'WhatsApp', href: site.socials.whatsapp },
  { label: 'Instagram', href: site.socials.instagram },
  { label: 'TikTok', href: site.socials.tiktok },
]
---

<footer class="bg-plum py-10 text-center text-white">
  <p class="font-serif text-2xl">{site.brand}</p>
  <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-white/80">
    г. Гомель, площадь Привокзальная, 1<br />
    гостиница «Гомель», 7 этаж, каб. 716
  </p>
  <nav class="mt-5 flex flex-wrap justify-center gap-4" aria-label="Социальные сети">
    {socials.map((s) => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-card border border-white/25 px-4 py-2 text-sm font-semibold transition hover:border-accent hover:bg-accent"
      >
        {s.label}
      </a>
    ))}
  </nav>
  <p class="mt-6 text-xs text-white/60">
    © {new Date().getFullYear()} {site.brand}. Дипломированный косметолог-эстетист в Гомеле.
  </p>
</footer>