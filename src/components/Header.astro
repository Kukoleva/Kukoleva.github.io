---
import { site } from '../lib/site'

const nav = [
  { href: '/', label: 'Главная' },
  { href: '/services/', label: 'Услуги и цены' },
  { href: '/#works', label: 'Работы' },
  { href: '/#reviews', label: 'Отзывы' },
  { href: '/#faq', label: 'Вопросы' },
  { href: '/#contacts', label: 'Контакты' },
]

const callLinks = [
  { label: '📞 Позвонить', href: `tel:${site.phone}` },
  { label: '💬 WhatsApp', href: site.socials.whatsapp, external: true },
  { label: '✈️ Telegram', href: site.socials.telegram, external: true },
  { label: '📸 Instagram', href: site.socials.instagram, external: true },
  { label: '🎵 TikTok', href: site.socials.tiktok, external: true },
]
---

<header
  transition:persist="site-header"
  data-header
  class="sticky top-0 z-40 bg-plum text-white transition-colors duration-300"
>
  <div
    data-progress
    class="h-0.5 origin-left bg-gradient-to-r from-accent to-accent-dark"
    style="transform: scaleX(0)"
  ></div>

  <div class="flex h-[70px] items-center justify-between px-4 md:px-8">
    <a href="/" class="font-serif text-2xl tracking-wide">{site.brand}</a>

    <nav data-menu aria-label="Главное меню" class="nav-drawer">
      {nav.map((n) => (
        <a
          href={n.href}
          data-menu-close
          class="nav-link"
        >
          {n.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <button
        type="button"
        data-dialog-open="call-dialog"
        class="rounded-card bg-btn px-4 py-2 font-semibold text-white shadow-btn transition hover:bg-btn-dark hover:shadow-btn-hover"
      >
        📞 Связаться
      </button>
      <button
        type="button"
        data-burger
        aria-label="Открыть меню"
        aria-expanded="false"
        class="burger flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Модальное окно «Связаться» -->
  <dialog id="call-dialog" class="rounded-card w-full max-w-xs shadow-card" aria-label="Связаться с нами">
    <div class="bg-card p-6 text-center text-fg">
      <p class="mb-4 font-serif text-2xl text-plum">Связаться с нами</p>
      <div class="flex flex-col gap-2">
        {callLinks.map((l) => (
          <a
            href={l.href}
            {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class="rounded-card border border-border px-4 py-3 font-semibold text-plum transition hover:border-accent hover:bg-accent/10"
          >
            {l.label}
          </a>
        ))}
      </div>
      <button
        type="button"
        data-dialog-close
        class="mt-4 w-full rounded-card bg-btn py-3 font-semibold text-white transition hover:bg-btn-dark"
      >
        Закрыть
      </button>
    </div>
  </dialog>
</header>

<style>
  .nav-drawer {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 40;
    width: 16rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: var(--color-plum-dark);
    padding: 5rem 1.5rem 1.5rem;
    transform: translateX(-100%);
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .nav-drawer.is-open {
    transform: translateX(0);
  }
  .nav-link {
    position: relative;
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    transition: background 0.2s;
  }
  .nav-link:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .burger span {
    height: 2px;
    width: 1.5rem;
    background: #fff;
    transition: transform 0.2s, opacity 0.2s;
  }
  .burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (min-width: 768px) {
    .nav-drawer {
      position: static;
      width: auto;
      flex-direction: row;
      align-items: center;
      gap: 1.25rem;
      background: transparent;
      padding: 0;
      transform: none;
    }
  }

  [data-header].is-scrolled {
    background: color-mix(in srgb, var(--color-plum) 88%, transparent);
    box-shadow: 0 8px 30px -12px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(12px);
  }
</style>

<script>
  const w = window as unknown as { __beautyHeader?: boolean }
  if (!w.__beautyHeader) {
    w.__beautyHeader = true
    const header = document.querySelector<HTMLElement>('[data-header]')
    const progress = document.querySelector<HTMLElement>('[data-progress]')

    const onScroll = () => {
      const y = window.scrollY
      header?.classList.toggle('is-scrolled', y > 10)
      const max = document.documentElement.scrollHeight - window.innerHeight
      if (progress) progress.style.transform = `scaleX(${max > 0 ? y / max : 0})`
    }
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null
      if (!target) return

      const burger = target.closest('[data-burger]')
      const menu = document.querySelector<HTMLElement>('[data-menu]')
      if (burger && menu) {
        menu.classList.toggle('is-open')
        burger.setAttribute('aria-expanded', String(menu.classList.contains('is-open')))
      }

      const close = target.closest('[data-menu-close]')
      if (close) menu?.classList.remove('is-open')

      const openDlg = target.closest<HTMLElement>('[data-dialog-open]')
      if (openDlg) {
        const id = openDlg.dataset.dialogOpen
        if (id) (document.getElementById(id) as HTMLDialogElement | null)?.showModal()
      }

      const closeDlg = target.closest('[data-dialog-close]')
      if (closeDlg) (closeDlg.closest('dialog') as HTMLDialogElement | null)?.close()
    })
  }
</script>