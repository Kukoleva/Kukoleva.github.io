---
import { getCollection, render } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import ServiceCard from '../../components/ServiceCard.astro'
import { site, serviceSchema, breadcrumbSchema } from '../../lib/site'

export async function getStaticPaths() {
  const services = await getCollection('services')
  return services.map((s) => ({
    params: { slug: s.id },
    props: { service: s },
  }))
}

const { service } = Astro.props
const { Content } = await render(service)

const category = (await getCollection('categories')).find((c) => c.id === service.data.category)
const related = (await getCollection('services')).filter(
  (s) => s.data.category === service.data.category && s.id !== service.id,
)

const title = `${service.data.title} — Beauty Studio, Гомель`
const description = service.data.shortDescription

const bookUrl =
  site.socials.whatsapp +
  '?text=' +
  encodeURIComponent(`Здравствуйте! Хочу записаться на: ${service.data.title} (${service.data.price} р).`)

const crumbs = [
  { name: 'Главная', url: site.url + '/' },
  { name: 'Услуги', url: site.url + '/services/' },
  ...(category ? [{ name: category.data.title, url: site.url + `/services/${category.id}/` }] : []),
  { name: service.data.title },
]
---

<Layout
  title={title}
  description={description}
  path={`/services/${service.id}/`}
  type="article"
  jsonLd={[
    serviceSchema({ title: service.data.title, description: service.data.description, price: service.data.price }),
    breadcrumbSchema(crumbs),
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'Главная', href: '/' },
      { label: 'Услуги', href: '/services/' },
      ...(category ? [{ label: category.data.title, href: `/services/${category.id}/` }] : []),
      { label: service.data.title },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-10">
    <header class="border-b border-border pb-6">
      <div class="flex flex-wrap items-center gap-3">
        {category && (
          <a
            href={`/services/${category.id}/`}
            class="rounded-full bg-accent-soft px-3 py-1 text-xs font-bold uppercase tracking-wide text-accent-dark transition hover:bg-accent/20"
          >
            {category.data.icon} {category.data.title}
          </a>
        )}
        {service.data.duration && (
          <span class="rounded-full border border-border px-3 py-1 text-xs font-semibold text-fg/60">
            ⏱ {service.data.duration}
          </span>
        )}
      </div>
      <h1 class="mt-4 font-serif text-3xl leading-tight text-plum md:text-5xl">{service.data.title}</h1>
      <p class="mt-3 text-2xl font-bold text-accent-dark">{service.data.price} р</p>
    </header>

    <div class="md-content mt-8">
      <Content />
    </div>

    <!-- ЗАПИСЬ -->
    <div class="mt-10 rounded-card bg-plum p-6 text-white md:p-8">
      <h2 class="font-serif text-2xl md:text-3xl">Записаться на процедуру</h2>
      <p class="mt-2 text-white/80">Позвоните или напишите в мессенджер — подберём удобное время.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href={bookUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-card bg-btn px-6 py-3 font-semibold text-white shadow-btn transition hover:bg-btn-dark"
        >
          💬 Записаться в WhatsApp
        </a>
        <a
          href={site.socials.telegram}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-card border border-white/40 px-6 py-3 font-semibold transition hover:bg-white/10"
        >
          ✈️ Telegram
        </a>
        <a
          href={`tel:${site.phone}`}
          class="rounded-card border border-white/40 px-6 py-3 font-semibold transition hover:bg-white/10"
        >
          📞 {site.phoneDisplay}
        </a>
      </div>
    </div>

    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="font-serif text-2xl text-plum md:text-3xl">Похожие процедуры</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          {related.slice(0, 4).map((s) => (
            <ServiceCard
              href={`/services/${s.id}/`}
              title={s.data.title}
              price={s.data.price}
              description={s.data.shortDescription}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>