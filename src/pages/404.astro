---
import Layout from '../layouts/Layout.astro'
---

<Layout
  title="Страница не найдена — Beauty Studio, Гомель"
  description="Запрашиваемая страница не найдена. Перейдите в каталог услуг косметолога в Гомеле."
  path="/404"
  noindex
>
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="font-serif text-7xl text-plum">404</p>
    <h1 class="mt-4 font-serif text-2xl text-plum">Страница не найдена</h1>
    <p class="mt-4 text-fg/70">
      Такой страницы нет. Возможно, вы искали услугу — загляните в каталог.
    </p>
    <a
      href="/services/"
      class="mt-6 inline-block rounded-card bg-plum px-8 py-3 font-semibold text-white transition hover:bg-accent-dark"
    >
      К услугам →
    </a>
  </section>
</Layout>